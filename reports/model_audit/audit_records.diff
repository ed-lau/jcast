+# AUDIT ONLY (reports/model_audit/audit_records.diff): every record of every junction, written or not, as a line of
+# JCAST_AUDIT_RECORDS: splice type, rMATS id, gene id, read count, file suffix, SHA-1 of the sequence, its length,
+# whether it was written, its header
+_audit_fh = None
+
+
+def _audit_record(junction, suffix, seqrecord, written) -> None:
+    global _audit_fh
+    path = os.environ.get('JCAST_AUDIT_RECORDS')
+    if not path:
+        return
+    if _audit_fh is None:
+        _audit_fh = open(path, 'a')
+    seq = str(seqrecord.seq)
+    _audit_fh.write('\t'.join([junction.junction_type, str(junction.name), str(junction.gene_id),
+                               str(junction.min_jc), suffix, hashlib.sha1(seq.encode()).hexdigest(),
+                               str(len(seq)), str(int(written)), seqrecord.id]) + '\n')
+    _audit_fh.flush()
+
